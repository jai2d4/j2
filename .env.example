# ---- Gemini / google-genai (native SDK reads GEMINI_API_KEY automatically) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ---- PostgreSQL ----
# Preferred: a full connection string from a hosted provider (Neon, Supabase, etc).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Fallback if DATABASE_URL is unset — used to build a local connection string.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tru_scouting
POSTGRES_USER=tru_admin
POSTGRES_PASSWORD=change_me

# ---- App ----
APP_ENV=development
UPLOAD_TMP_DIR=/tmp/tru_uploads
MAX_UPLOAD_MB=500
