# ---- Gemini / google-genai (native SDK reads GEMINI_API_KEY automatically) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tru_scouting
POSTGRES_USER=tru_admin
POSTGRES_PASSWORD=change_me

# ---- App ----
APP_ENV=development
UPLOAD_TMP_DIR=/tmp/tru_uploads
MAX_UPLOAD_MB=500

# ---- Phase 1 local/private defaults ----
TRUGRADE_DEMO_MODE=true
AI_PROVIDER=google
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-5-mini
GOOGLE_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_SEND_VIDEO=false
AI_SEND_FRAMES=true
AI_MAX_FRAMES_PER_PLAY=8
YOLO_MODEL_PATH=yolo11n.pt
TRUGRADE_STORAGE_DIR=backend/storage
ANALYSIS_FPS=10

# ---- Auth ----
# Leave unset for local dev (no auth). Set before exposing the app publicly —
# every /api/v1/scout/*, /api/v1/athletes, and /api/v1/evaluations route then
# requires a matching X-API-Key header. /api/v1/health always stays open.
API_KEY=
