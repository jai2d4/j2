# ---- Database ----
# Defaults to a local SQLite file, so the app runs with zero setup.
# Point at Postgres for anything real: postgresql+asyncpg://user:pass@host:5432/livephoria
# A bare postgres:// / postgresql:// URL (Render, Neon, Replit) is rewritten automatically.
DATABASE_URL=sqlite+aiosqlite:///./livephoria.db

# ---- Auth ----
# REQUIRED outside local dev. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset, the app boots with an ephemeral dev secret and every token dies on restart.
JWT_SECRET=
JWT_TTL_MINUTES=10080

# ---- Money ----
# Platform's cut of creator revenue, in basis points. 1000 = 10%.
PLATFORM_FEE_BPS=1000
# Wallet top-ups are simulated in-process (see app/services/payments.py).
# No card is charged and no money moves until a real PSP is wired in.
PAYMENTS_PROVIDER=mock

# ---- App ----
APP_ENV=development

# ---- Axiome control plane ----
# Axiome is the operator's controller app. Leave AXIOME_BASE_URL empty and this
# app runs standalone with the integration inert.
# Outbound: where Livephoria registers itself and sends heartbeats/events.
AXIOME_BASE_URL=
AXIOME_APP_KEY=
AXIOME_PUBLIC_URL=
AXIOME_HEARTBEAT_SECONDS=60
# Inbound: the shared secret Axiome must send as X-Axiome-Key on /api/v1/control/*.
# Unset means those routes refuse every caller — closed, not open.
AXIOME_CONTROL_KEY=
