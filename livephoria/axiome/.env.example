# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./axiome.db

# ---- Admin ----
# The key that opens the dashboard and the /api/admin routes.
# Leave blank and one is generated at boot and printed to the log — dev only.
ADMIN_KEY=

# ---- Registration ----
# Apps must present an app key issued by Axiome ("Add app" in the dashboard).
# Turn this on only for local development: it lets any app self-register.
OPEN_REGISTRATION=false

# ---- Polling ----
# How often Axiome pulls status from each connected app. 0 disables polling.
POLL_SECONDS=60
POLL_TIMEOUT_SECONDS=5
