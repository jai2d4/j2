# Build output
build/
build-*/
cmake-build-*/
out/
*.o
*.a
*.so
*.dll
*.exe
*.pdb
*.ilk
CMakeUserPresets.json

# Evidence and case data never belong in version control. TRACE_DATA holds
# managed originals, derived assets and the case database; these are real
# evidence in a deployment and private case material in development.
TRACE_DATA/
trace_data/
*.db
*.db-wal
*.db-shm
*.trace-case

# Logs and caches
logs/
*.log
thumbnails/
.cache/

# Secrets and local configuration
.env
*.pem
*.key
*.pfx
credentials.json

# Editor and OS noise
.vscode/
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db

# Everything under tests/fixtures is deliberately committed: the sample video
# is generated by scripts/make_sample_video.sh and is safe to distribute.
!tests/fixtures/sample.mp4

# ---------------------------------------------------------------- Phase 1
# Runtime artefacts fetched by scripts, never committed. They are large, they
# carry their own licences, and their digests are recorded in the model
# catalogue rather than in git.
third_party/onnxruntime/
models/
*.onnx
*.trt
*.engine
# Test media downloaded by scripts/fetch_test_media.sh from upstream projects.
tests/fixtures/external/

# Analysis output belongs to a case, not to the repository.
analysis_cache/
detections_export/
